# ============================================================
# DarkX .gitignore
# Python interpreter (src/, tests/) + Node/VS Code extension
# (editors/vscode-darkx/)
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# Testing / coverage
.pytest_cache/
.cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.tox/
.nox/

# Type checkers / linters
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pytype/

# ---------- Node.js / VS Code extension (editors/vscode-darkx) ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json.bak
*.vsix
.vscode-test/

# ---------- Editor / IDE ----------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# ---------- OS ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---------- Secrets / local config (jaga-jaga) ----------
.env
.env.*
!.env.example
*.pem
*.key
*credentials*

# ---------- Project build artifacts ----------
*.log
*.tmp
.darkx-cache/
