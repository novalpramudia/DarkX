## ============================================
## DarkX - percabangan (:: / ??)
## ============================================

::: umur === 20 ;;

:: ((umur >=? 18)) {{
    >>> "Status: Dewasa" ;;
}} ?? {{
    >>> "Status: Anak-anak" ;;
}}

::: nilai === 72 ;;

:: ((nilai >=? 90)) {{
    >>> "Grade: A" ;;
}} ?? {{
    :: ((nilai >=? 70)) {{
        >>> "Grade: B" ;;
    }} ?? {{
        >>> "Grade: C" ;;
    }}
}}
