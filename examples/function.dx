## ============================================
## DarkX - fungsi, rekursi, dan '<=' (return)
## ============================================

=> fib((n)) {{
    :: ((n <=? 1)) {{
        <= n ;;
    }}
    <= fib((n --- 1)) +++ fib((n --- 2)) ;;
}}

=> sapa((nama)) {{
    <= "Halo, " +++ nama +++ "!" ;;
}}

::: i === 0 ;;
~~ ((i <? 10)) {{
    >>> "fib((" ,, i ,, ")) ===" ,, fib((i)) ;;
    i === i +++ 1 ;;
}}

>>> sapa(("DarkX Programmer")) ;;
