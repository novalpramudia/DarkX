## ============================================
## DarkX - variabel, angka, string, operator
## ============================================

::: nama === "DarkX" ;;
::: versi === 1 ;;
::: pi === 3.14 ;;

>>> "Bahasa:" ,, nama ;;
>>> "Versi:" ,, versi ;;

::: a === 10 ;;
::: b === 3 ;;

>>> "a +++ b ===" ,, a +++ b ;;
>>> "a --- b ===" ,, a --- b ;;
>>> "a ** b ===" ,, a ** b ;;
>>> "a // b ===" ,, a // b ;;
>>> "a %% b ===" ,, a %% b ;;

::: greeting === "Halo, " +++ nama +++ "!" ;;
>>> greeting ;;
